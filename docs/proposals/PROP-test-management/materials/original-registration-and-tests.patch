+def test_test_management_is_self_contained_and_within_budget() -> None:
+    root = _playbook_root("test-management")
+    files = _assert_self_contained_within_budget(root, TEST_MANAGEMENT)
+    assert {path.relative_to(root).as_posix() for path in root.rglob("*") if path.is_file()} == set(TEST_MANAGEMENT)
+    references = [name for name in TEST_MANAGEMENT if name.startswith("references/")]
+    items = re.split(r"\n\s*\n|\n(?=\d+\. )", files["SKILL.md"].read_text())
+    for name in references:
+        linking = [_collapsed(item).lower() for item in items if f"`{name}`" in item]
+        assert linking, name
+        assert all("read" in item and ("before" in item or "when" in item) for item in linking), name
+        text = files[name].read_text()
+        assert not [other for other in references if other != name and other in text], name
