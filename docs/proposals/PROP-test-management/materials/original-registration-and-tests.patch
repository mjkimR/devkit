+def test_test_management_entry_condition_and_description() -> None:
+    description, body = _description_and_body(_playbook_root("test-management"))
+    assert_rule(description, "audit", "organize", "optimize", "test")
+    assert_rule(body, "only when", "invoked", "confirmed", "`devkit playbook get maintenance/test-management`")
+    assert_rule(body, "invocation", "authorize no change")
