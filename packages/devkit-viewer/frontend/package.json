{
	"name": "devkit-viewer",
	"version": "0.1.0",
	"description": "Svelte viewer of devkit repositories: the Living Spec, proposals, specs and the milestone roadmap",
	"license": "UNLICENSED",
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build:app": "vite build",
		"package": "svelte-package -i src/lib -o dist",
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test": "vitest run"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"dompurify": "^3.4.16",
		"marked": "^18.1.0",
		"mermaid": "^12.1.0",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@sveltejs/package": "^2.5.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^22.20.5",
		"jsdom": "^30.0.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^5.8.2",
		"vite": "^8.0.16",
		"vitest": "^5.0.0"
	}
}
